{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://goistdwnwksaskbffsni.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "slideai",
      "version": "0.1.0",
      "title": "SlideAI"
    },
    "tools": [
      {
        "name": "list_presentations",
        "title": "List presentations",
        "description": "List the signed-in user's SlideAI presentations, newest first, with title, slug, slide count and views.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 120,
              "description": "Optional text to match against the title."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "How many presentations to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_presentation",
        "title": "Get presentation",
        "description": "Read one of the signed-in user's presentations by slug, including every slide's content and speaker notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The presentation slug, as returned by list_presentations."
            },
            "include_slides": {
              "type": "boolean",
              "description": "Include full slide content (default true)."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_presentation",
        "title": "Update presentation details",
        "description": "Rename a presentation, change its description, or publish/unpublish it. Slides are not modified.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The presentation slug to update."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "New title."
            },
            "description": {
              "type": "string",
              "maxLength": 1000,
              "description": "New description."
            },
            "is_published": {
              "type": "boolean",
              "description": "Whether the presentation is publicly shareable."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_credit_balance",
        "title": "Get credit balance",
        "description": "Read the signed-in user's SlideAI plan, subscription status and available credits (monthly quota plus permanent bonus).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_history": {
              "type": "boolean",
              "description": "Also return the 10 most recent credit movements (default false)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_help_articles",
        "title": "Search help articles",
        "description": "Search SlideAI's published help center articles by title, category or keyword.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "What to look for, e.g. 'créditos' or 'reembolso'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "How many articles to return (default 5)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
