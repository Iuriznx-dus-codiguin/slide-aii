{
  "name": "slideai-youtube-ad",
  "private": true,
  "version": "1.0.0",
  "description": "Comercial de 45s (16:9) do SlideAI para o YouTube, feito em Remotion.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "still": "remotion still SlideAIComercial --scale=0.5",
    "render": "remotion render SlideAIComercial out/slideai-comercial-45s-16x9.mp4 --codec=h264 --crf=17",
    "music": "node scripts/make-music.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "typescript": "5.8.3"
  }
}
